{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "identity-route-api": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/identity/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/identity" }
        ]
      },
      "identity-route-auth": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/auth/{**catch-all}"
        }
      },
      "identity-route-admin": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/admin/{**catch-all}"
        }
      },
      "identity-route-drivers": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/drivers/{**catch-all}"
        }
      },

      "catalog-route-api": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/catalog/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/catalog" }
        ]
      },
      "catalog-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/api/catalog/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/catalog" }
        ]
      },

      "cart-route-api": {
        "ClusterId": "cart-cluster",
        "Match": {
          "Path": "/cart/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/cart" }
        ]
      },
      "cart-route": {
        "ClusterId": "cart-cluster",
        "Match": {
          "Path": "/api/cart/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/cart" }
        ]
      },

      "order-route-api": {
        "ClusterId": "order-cluster",
        "Match": {
          "Path": "/order/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/order" }
        ]
      },
      "order-route": {
        "ClusterId": "order-cluster",
        "Match": {
          "Path": "/api/order/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/order" }
        ]
      },

      "payment-route-api": {
        "ClusterId": "payment-cluster",
        "Match": {
          "Path": "/payment/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/payment" }
        ]
      },
      "payment-route": {
        "ClusterId": "payment-cluster",
        "Match": {
          "Path": "/api/payment/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/payment" }
        ]
      },

      "address-route-api": {
        "ClusterId": "address-cluster",
        "Match": {
          "Path": "/address/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/address" }
        ]
      },
      "address-route": {
        "ClusterId": "address-cluster",
        "Match": {
          "Path": "/api/address/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/address" }
        ]
      },
      "address-cities-route": {
        "ClusterId": "address-cluster",
        "Match": {
          "Path": "/api/cities/{**catch-all}"
        }
      },
      "address-cities-root-route": {
        "ClusterId": "address-cluster",
        "Match": {
          "Path": "/api/cities"
        }
      },
      "address-users-me-route": {
        "ClusterId": "address-cluster",
        "Match": {
          "Path": "/users/me/addresses/{**catch-all}"
        }
      },
      "address-users-me-root-route": {
        "ClusterId": "address-cluster",
        "Match": {
          "Path": "/users/me/addresses"
        }
      },
      "address-stores-route": {
        "ClusterId": "address-cluster",
        "Match": {
          "Path": "/api/stores/{**catch-all}"
        }
      },
      "address-admin-stores-route": {
        "ClusterId": "address-cluster",
        "Match": {
          "Path": "/admin/stores/{**catch-all}"
        }
      },
      "address-admin-stores-root-route": {
        "ClusterId": "address-cluster",
        "Match": {
          "Path": "/admin/stores"
        }
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://identity-api:8080"
          }
        }
      },
      "catalog-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://catalog-service:8080"
          }
        }
      },
      "cart-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://cart-service:8080"
          }
        }
      },
      "order-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://order-service:8080"
          }
        }
      },
      "payment-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://payment-service:8080"
          }
        }
      },
      "address-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://address-service:8080"
          }
        }
      }
    }
  }
}
