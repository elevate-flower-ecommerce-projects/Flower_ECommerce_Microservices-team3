      "description": "Occasion ID for filtering products by occasion"
    },
    {
      "key": "categoryId",
      "value": "11111111-1111-1111-1111-111111111111",
      "type": "string",
      "description": "Category ID for filtering products by category"
    },
    {
      "key": "productId",
      "value": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
      "type": "string",
      "description": "Product ID for fetching product details / adding to cart"
    },
    {
      "key": "addressId",
      "value": "",
      "type": "string",
      "description": "Address ID for address operations"
    }
  ],
