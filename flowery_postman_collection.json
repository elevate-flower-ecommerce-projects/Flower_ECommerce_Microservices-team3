    {
      "name": "Catalog & Home",
      "item": [
        {
          "name": "Get Home Sections",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData && jsonData.data && jsonData.data.length > 0) {",
                  "    var sectionWithOccasion = jsonData.data.find(function(s) { return s.occasionId; });",
                  "    if (sectionWithOccasion && sectionWithOccasion.occasionId) {",
                  "        pm.collectionVariables.set('occasionId', sectionWithOccasion.occasionId);",
                  "        console.log('Saved occasionId from home sections: ' + sectionWithOccasion.occasionId);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept-Language",
                "value": "{{acceptLanguage}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/catalog/home/sections",
              "host": ["{{baseUrl}}"],
              "path": ["catalog", "home", "sections"]
            }
          }
        },
        {
          "name": "Get Active Occasions (Paginated)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData && jsonData.data && jsonData.data.items && jsonData.data.items.length > 0) {",
                  "    var firstOccasion = jsonData.data.items[0];",
                  "    pm.collectionVariables.set('occasionId', firstOccasion.id);",
                  "    console.log('Saved occasionId from occasions list: ' + firstOccasion.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept-Language",
                "value": "{{acceptLanguage}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/catalog/occasions?pageNumber=1&pageSize=10",
              "host": ["{{baseUrl}}"],
              "path": ["catalog", "occasions"],
              "query": [
                {
                  "key": "pageNumber",
                  "value": "1"
                },
                {
                  "key": "pageSize",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Get Products (Paginated, Filterable, Searchable)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData && jsonData.data && jsonData.data.items && jsonData.data.items.length > 0) {",
                  "    var firstProduct = jsonData.data.items[0];",
                  "    pm.collectionVariables.set('productId', firstProduct.id);",
                  "    console.log('Saved productId from products list: ' + firstProduct.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept-Language",
                "value": "{{acceptLanguage}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/catalog/products?categoryId={{categoryId}}&occasionId={{occasionId}}&keyword=&sortBy=PriceLowToHigh&page=1&pageSize=10",
              "host": ["{{baseUrl}}"],
              "path": ["catalog", "products"],
              "query": [
                {
                  "key": "categoryId",
                  "value": "{{categoryId}}",
                  "description": "Filter by Category ID (optional)"
                },
                {
                  "key": "occasionId",
                  "value": "{{occasionId}}",
                  "description": "Filter by Occasion ID (optional)"
                },
                {
                  "key": "keyword",
                  "value": "",
                  "description": "Search keyword for product name (optional)"
                },
                {
                  "key": "sortBy",
                  "value": "PriceLowToHigh",
                  "description": "Sort order: PriceLowToHigh, PriceHighToLow, Newest, Oldest, Discount (optional)"
                },
                {
                  "key": "page",
                  "value": "1",
                  "description": "1-based page number (default: 1)"
                },
                {
                  "key": "pageSize",
                  "value": "10",
                  "description": "Items per page (default: 10)"
                }
              ]
            }
          }
        },
