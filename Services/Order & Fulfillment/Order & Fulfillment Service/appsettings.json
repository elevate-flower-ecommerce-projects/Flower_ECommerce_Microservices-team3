{
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=FlowersOrderDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true;"
  },
  "JwtSettings": {
    "Secret": "YOUR_SUPER_SECRET_KEY_CHANGE_IN_PRODUCTION_MIN_32_CHARS",
    "Issuer": "FlowersAuth",
    "Audience": "FlowersApp"
  },
  "CartService": {
    "BaseUrl": "http://cart-service:8080"
  },
  "AddressService": {
    "BaseUrl": "http://address-service:8080"
  },
  "PaymentService": {
    "BaseUrl": "http://payment-service:8080"
  },
